def desktop_version():
    processes = subprocess.run(['ps', '-Ao', 'comm='], capture_output=True, text=True).stdout
    match = re.search(r'^(/Applications/T3 Code[^/]*\.app)', processes, re.M)
    bundle = match[1] if match else '/Applications/T3 Code (Nightly).app'
    try:
        with open(bundle + '/Contents/Info.plist', 'rb') as file:
            return plistlib.load(file).get('CFBundleShortVersionString', '')
    except (OSError, plistlib.InvalidFileException):
        return ''


def servers_file():
    config = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
    return Path(os.environ.get('T3UP_SERVERS_FILE', config / 't3up/servers'))


def parse_servers(text):
    """One SSH alias or user@host per line; blank lines and # comments ignored."""
    hosts = [h for h in dict.fromkeys(line.split('#', 1)[0].strip() for line in text.splitlines()) if h]
    for host in hosts:
        if not HOST.fullmatch(host):
            raise ValueError(f'invalid server {host!r}')
    return hosts


def ssh_hosts():
    """Concrete Host aliases from ~/.ssh/config, offered as suggestions."""
    try:
        text = (Path.home() / '.ssh/config').read_text()
    except OSError:
        return []
    return [host for line in text.splitlines() if (words := line.split()) and words[0].lower() == 'host'
            for host in words[1:] if HOST.fullmatch(host)]


def clean(text):
    text = re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]', '', text)
    return ''.join(c for c in text if c >= ' ' or c == '\t').strip()


def version_text(detail):
    """'Codex: codex-cli 1.0.0 -> codex-cli 1.1.0' -> '1.0.0 → 1.1.0'; unchanged -> '1.0.0'."""
    versions = re.findall(r'\d+\.\d+\.\d+(?:[-+][a-zA-Z0-9.+-]+)?', detail)
    if len(versions) >= 2:
        return versions[-1] if versions[0] == versions[-1] else f'{versions[0]} → {versions[-1]}'
    return detail.split(': ', 1)[-1]


class Host:
    def __init__(self, name):
        self.name, self.lines = name, deque(maxlen=2000)
        self.reset('')
        self.status = 'idle'

    def reset(self, mode):
        self.mode, self.status, self.stage, self.steps = mode, 'running', 'Connecting', {}
        self.error, self.version, self.log = '', '—', None
        self.started, self.elapsed = time.monotonic(), 0.0


async def read_lines(stream, limit=1 << 16):
    """Yield output lines split on \\n or \\r; overlong lines are cut, never fatal."""
    buffer = b''
    while True:
        chunk = await stream.read(limit)
        if not chunk:
            break
        *lines, buffer = re.split(rb'[\r\n]', buffer + chunk)
        if len(buffer) > limit:
            lines.append(buffer)
            buffer = b''
        for line in lines:
            yield line
    if buffer:
        yield buffer


async def run_job(h, mode, version, app, only, logs, emit):
    """Run the remote script on one host; emit(host, kind, text) on every change."""
    h.reset(mode)
    logs.mkdir(parents=True, exist_ok=True)
    h.log = logs / f'{h.name}-{time.strftime("%H%M%S")}-{mode}.log'
    h.lines.append(f'── {mode}{" " + only if mode == "update" else ""} · {time.strftime("%H:%M:%S")} ──')
    emit(h, 'start', h.lines[-1])
    command = ['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10',
               '-o', 'ServerAliveInterval=15', '-o', 'ServerAliveCountMax=2', h.name,
               shlex.join(['sh', '-s', '--', mode, version, app, only])]
    complete, last, status = False, '', None
    process = None
    try:
        process = await asyncio.create_subprocess_exec(*command, stdin=PIPE, stdout=PIPE, stderr=STDOUT)
        try:
            process.stdin.write(REMOTE.encode())
            await process.stdin.drain()
            process.stdin.close()
        except (BrokenPipeError, ConnectionResetError):
            pass
        with h.log.open('w') as log:
            async for raw in read_lines(process.stdout):
                line = raw.decode(errors='replace') + '\n'
                log.write(line)
                log.flush()
                text = clean(line)
                if not text.startswith('@@t3up\t'):
                    if text:
                        last = text
                        h.lines.append(text)
                        emit(h, 'line', text)
                    continue
                _, event, detail = text.split('\t', 2)
                if event == 'begin':
                    h.stage = detail
                    emit(h, 'stage', detail)
                elif event in ('done', 'skip'):
                    step = 'Health' if detail.startswith('Health') else detail.split(':', 1)[0]
                    value = version_text(detail)
                    if step == 'Health':
                        value = 'Online · desktop matches' if app else 'Online · desktop not detected'
                    h.steps[step] = (event, value)
                    h.lines.append(f'{"✓" if event == "done" else "–"} {step}  {value}')
                    emit(h, 'step', h.lines[-1])
                elif event == 'version':
                    h.version = detail
                elif event == 'complete':
                    complete = True
        status = await process.wait()
    except Exception as error:  # not CancelledError: quitting still propagates
        last = f'{type(error).__name__}: {error}'
    finally:
        if process and process.returncode is None:
            process.terminate()
    ok = status == 0 and complete
    h.status, h.elapsed = ('ok' if ok else 'failed'), time.monotonic() - h.started
    if not ok:
        h.error = last or f'Failed during {h.stage}'
    emit(h, 'done', h.error)



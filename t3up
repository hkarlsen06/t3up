SPIN = '⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
TILE, GAP, LOGO_LINES = 9, 1, 2  # a tool's tile: its width, the gap between tiles, its logo's height


# Graphite neutrals, one blue accent; green/amber/red only ever mean status.
BG, SURFACE, LINE = '#16161a', '#1f1f24', '#34343c'
TEXT, MUTED, DIM, FAINT = '#ececf1', '#a1a1ab', '#6e6e78', '#45454d'
ACCENT, GREEN, AMBER, RED = '#82aaff', '#6fd39a', '#e5b567', '#f07178'
THEME = Theme('t3up', primary=ACCENT, accent=ACCENT, success=GREEN, warning=AMBER, error=RED,
              foreground=TEXT, background=BG, surface=SURFACE, panel=SURFACE, dark=True,
              variables={'footer-key-foreground': ACCENT, 'footer-background': BG,
                         'footer-item-background': BG, 'block-cursor-background': ACCENT + '33',
                         'block-cursor-foreground': TEXT, 'block-cursor-text-style': 'none',
                         'block-hover-background': ACCENT + '1a', 'border': ACCENT,
                         'scrollbar': LINE, 'scrollbar-hover': FAINT, 'scrollbar-background': BG})

def status(h, now):
    """(icon, color, label) summarising a host, e.g. ('✓', GREEN, 'healthy')."""
    if h.status == 'running':
        return SPIN[int(now * 10) % 10], AMBER, 'updating' if h.mode == 'update' else 'checking'
    return {'idle': ('·', DIM, 'not checked'), 'failed': ('✗', RED, 'failed'),
            'ok': ('✓', GREEN, 'updated' if h.mode == 'update' else 'healthy')}[h.status]


def tile(h, name, now, logo, new=None):
    """The tool's logo over its version: '↑ 2.1.289' after an update, a spinner while it runs."""
    event, value = h.steps.get(name, ('', ''))
    if event == 'begin' and h.status == 'running':
        version = Text(SPIN[int(now * 10) % 10], style=AMBER)  # the card's border says what it is doing
    elif event in ('begin', 'fail'):
        version = Text('✗ failed', style=RED)
    elif ' → ' in value:  # 'a → b', or 'base (…23 → …33)' for a new build of one nightly
        done = '#' + h.current[name].rsplit('.', 1)[-1] if value.endswith(')') else value.split(' → ')[-1]
        version = Text(f'↑ {done}', style=f'bold {GREEN}')
    else:
        version = Text(value or '—', style=TEXT if event else FAINT)
    version.plain = version.plain.replace('-nightly', '')  # every server shares the channel; the header names it
    if name in h.auth:  # one line under the version, always there so every card is as tall
        note = Text('sign in', style=AMBER)
    elif new and h.status != 'running':
        note = Text(f'→ {compact(new, h.current[name])}', style=ACCENT)
    else:
        note = Text('')
    grid = Table.grid()
    grid.add_column(justify='center', width=TILE, no_wrap=True)
    grid.add_row(Align.center(logo))
    grid.add_row(version)
    grid.add_row(note)
    return grid


def versions_tooltip(h, new):
    """Every tool's full version, which tiles shorten, and the full version of any update."""
    width = max(map(len, h.current), default=0)
    return '\n'.join(f'{name:<{width}}  {version}' + (f'  →  {new[name]}' if name in new else '')
                     for name, version in sorted(h.current.items(), key=lambda item: list(COMPONENTS).index(item[0]))) or None


class Card(Static, can_focus=True):
    def __init__(self, host):
        super().__init__()
        self.host = host

    def on_focus(self):
        self.app.select(self.host)

    def on_click(self):
        self.focus()
        self.app.action_open()

    def on_resize(self):  # slots in one line, or wrapped tiles when they no longer fit
        self.show()

    def show(self):
        h, now = self.host, time.monotonic()
        running = h.status == 'running'
        lines = []
        if h.status == 'failed' and not h.steps:  # never got as far as a step: just say why, as tall as tiles
            lines += [Text(''), Text(f'✗ {h.error}', style=RED, no_wrap=True, overflow='ellipsis'),
                      Text('enter → retry or open a terminal', style=DIM), Text('')]
        else:
            new = updates(h, self.app.latest, self.app.target)
            tools = self.app.tools  # every tool any server has, so each sits in the same place on every card
            tiles = [tile(h, name, now, self.app.logos[name], new.get(name))
                     if name in h.installed and h.steps.get(name, ('begin',))[0] != 'skip' else Text('')
                     for name in tools]
            if self.content_size.width and self.content_size.width < len(tools) * (TILE + GAP) - GAP:
                lines.append(Columns([t for t in tiles if not isinstance(t, Text)], padding=(1, GAP)))  # too narrow: wrap
            else:
                row = Table.grid(expand=True)
                for _ in tools:
                    row.add_column(ratio=1, justify='center')
                row.add_row(*(Align.center(t) for t in tiles))
                lines.append(row)
            if h.error:
                lines.append(Text(f'✗ {h.error}', style=RED, no_wrap=True, overflow='ellipsis'))
        self.update(Group(*lines))
        icon, color, label = status(h, now)
        elapsed = now - h.started if running else h.elapsed
        took = '' if h.status == 'idle' else f'  [{DIM}]{elapsed:.{0 if running else 1}f}s[/]'
        self.border_title = f' {h.name} '
        self.tooltip = versions_tooltip(h, updates(h, self.app.latest, self.app.target))
        waiting = len(updates(h, self.app.latest, self.app.target)) if h.status == 'ok' else 0
        more = f' · [{ACCENT}]{waiting} to update[/]' if waiting else ''
        self.border_subtitle = f' [{color}]{icon} {label}[/]{more}{took} '
        self.set_classes(h.status)


class Dialog(ModalScreen):
    BINDINGS = [('escape', 'dismiss', 'Close')]

    def on_click(self, event):
        if event.widget is self:  # clicked the dimmed backdrop
            self.dismiss()


class Menu(Dialog):
    """Options are (id, icon, label, detail) tuples; a plain string starts a section."""
    def __init__(self, heading, options):
        super().__init__()
        self.heading, self.options = heading, options

    def compose(self):
        def row(item):
            if isinstance(item, str):
                gap = '' if item is self.options[0] else '\n'
                return Option(Text(gap + item.upper(), style=f'bold {DIM}'), disabled=True)
            key, icon, label, detail = item
            return Option(Text.assemble((f'{icon} ', ACCENT), (f'{label:<16}', 'bold'), (detail, MUTED)), id=key)
        with Vertical():
            yield Static(self.heading, classes='heading')
            yield OptionList(*map(row, self.options))
            yield Static('↑↓ move · enter choose · esc close', classes='hint')

    def on_mount(self):
        self.query_one(OptionList).action_first()  # skip the section header

    def on_option_list_option_selected(self, event):
        self.dismiss(event.option.id)


class VersionPrompt(Dialog):
    def __init__(self, current):
        super().__init__()
        self.current = current

    def compose(self):
        with Vertical():
            yield Static('T3 version to install', classes='heading')
            yield Input(self.current, placeholder='blank = latest nightly')
            yield Static('e.g. 0.0.46-nightly.20261003.2623 · enter save · esc cancel', classes='hint')

    def on_input_submitted(self, event):
        value = event.value.strip()
        if value and not VERSION.fullmatch(value):
            self.notify('Not a valid version', severity='error')
        else:
            self.dismiss(value)


class ServersEditor(Dialog):
    """Add/remove servers. Each change is written straight to the servers file, editing only
    that host's line, so the file's own comments survive. Closing applies the list."""
    def __init__(self):
        super().__init__()
        try:
            self.text = servers_file().read_text()
        except OSError:
            self.text = '# t3up servers: one SSH alias or user@host per line.\n'
        self.hosts = parse_servers(self.text)

    def compose(self):
        unused = [h for h in ssh_hosts() if h not in self.hosts]
        with Vertical():
            yield Static(Text.assemble(('Servers', 'bold'), (f'   {len(self.hosts)}', DIM)), classes='heading')
            with VerticalScroll(id='server-list'):
                for host in self.hosts:
                    with Horizontal(classes='server'):
                        yield Static(host)
                        yield Button('✕ Remove', name=host, classes='remove', compact=True)
                if not self.hosts:
                    yield Static('No servers yet. Add one below.', classes='hint')
            with Horizontal(id='add-row'):
                yield Input(placeholder='SSH alias or user@host', id='new-server')
                yield Button('+ Add', variant='primary', id='add', compact=True)
            if unused:
                with Horizontal(id='suggestions'):
                    yield Static('From ~/.ssh/config', classes='hint')
                    for host in unused:
                        yield Button(f'+ {host}', name=host, classes='suggest', compact=True)
            yield Static('esc or click outside when done', classes='hint')

    def on_mount(self):
        self.query_one(Input).focus()

    def write(self, text):
        path = servers_file()
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text.rstrip('\n') + '\n')
        self.text, self.hosts = text, parse_servers(text)
        self.refresh(recompose=True)
        self.call_after_refresh(lambda: self.query_one(Input).focus())

    def add(self, host):
        host = host.strip()
        if not HOST.fullmatch(host):
            self.notify(f'{host!r} is not an SSH host', severity='error')
        elif host in self.hosts:
            self.notify(f'{host} is already in the list', severity='warning')
        else:
            self.write(self.text.rstrip('\n') + '\n' + host)

    def on_input_submitted(self, event):
        self.add(event.value)

    def on_button_pressed(self, event):
        button = event.button
        if button.id == 'add':
            self.add(self.query_one(Input).value)
        elif button.has_class('suggest'):
            self.add(button.name)
        elif button.has_class('remove'):
            self.write('\n'.join(line for line in self.text.splitlines()
                                 if line.split('#', 1)[0].strip() != button.name))

    def dismiss(self, result=None):  # esc, backdrop click: always hand back the list
        return super().dismiss(self.hosts)


def load_logos():
    """Each tool's logo as an image renderable: the terminal's graphics protocol when it has one
    (Kitty's: Ghostty, kitty, WezTerm), else colored half blocks. Probes the terminal on first
    import, so this must run before Textual takes over stdin."""
    from PIL import Image as PILImage
    from textual_image.renderable import HalfcellImage, Image, TGPImage
    picture = Image if Image is TGPImage else HalfcellImage  # Sixel only works as a Textual widget
    def padded(name):  # a transparent strip on top keeps a logo off the card's border: less than a line
        logo = PILImage.open(io.BytesIO(base64.b64decode(LOGO_PNGS[name]))).convert('RGBA')
        canvas = PILImage.new('RGBA', (logo.width, logo.height * 5 // 4), (0, 0, 0, 0))
        canvas.paste(logo, (0, canvas.height - logo.height))
        return canvas
    return {name: picture(padded(name), width='auto', height=LOGO_LINES) for name in COMPONENTS}



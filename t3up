    Input { border: round $panel-lighten-2; background: transparent; }
    Input:focus { border: round $accent; }
    #add-row Input { width: 1fr; }
    ServersEditor #add, ServersEditor #add:hover, ServersEditor #add:focus {
        margin-left: 1; height: 3; min-width: 10; border: round $accent; background: transparent;
        color: $accent; text-style: bold; }
    #suggestions .hint { width: auto; margin: 0 1 0 0; }
    ServersEditor Button.suggest { margin-right: 1; background: transparent; color: $accent; }
    ServersEditor Button.suggest:hover { text-style: bold underline; }
    .heading { text-style: bold; margin-bottom: 1; }
    .hint { color: #6e6e78; margin-top: 1; }
    OptionList, OptionList:focus { height: auto; border: none; padding: 0; background: $surface;
                                   background-tint: transparent; }
    OptionList > .option-list--option { padding: 0 1; }
    '''
    BINDINGS = [
        Binding('enter', 'open', 'Actions'),
        Binding('r', 'refresh', 'Refresh'),
        Binding('u', 'update', 'Update server', show=False),
        Binding('a', 'update_all', 'Update all'),
        Binding('v', 'version', 'T3 version'),
        Binding('l', 'logs', 'Output', show=False),
        Binding('s', 'ssh', 'SSH', show=False),
        Binding('e', 'servers', 'Servers'),
        Binding('q', 'quit', 'Quit'),
        Binding('ctrl+c', 'quit', show=False, priority=True),
        Binding('left', 'move(-1, 0)', show=False),
        Binding('right', 'move(1, 0)', show=False),
        Binding('up,k', 'move(0, -1)', show=False),
        Binding('down,j', 'move(0, 1)', show=False),
    ]

    def __init__(self, names, logs):
        super().__init__()
        self.register_theme(THEME)
        self.theme = 't3up'
        self.names, self.hosts, self.cards = names, [], {}
        self.logs, self.target, self.desktop = logs, '', desktop_version()
        self.selected, self.quit_armed = None, 0.0
        self.terminal_lock = asyncio.Lock()
        # Direct refs, so the 0.1s tick can't hit a NoMatches while the app tears down.
        self.top, self.grid = Static(id='top'), Grid(id='cards')
        self.update_all = Button('↑  Update all servers', variant='primary', id='update-all')
        self.update_all.can_focus = False  # keyboard stays on the cards; 'a' does the same
        self.output = RichLog(wrap=True, markup=False, highlight=False)
        self.output.can_focus = False

    def compose(self):
        with Horizontal(id='bar'):
            yield self.top
            yield self.update_all
        yield self.grid
        yield self.output
        yield Footer()

    async def on_mount(self):
        self.set_interval(0.1, self.tick)
        await self.set_hosts(self.names)
        if not self.hosts:
            self.action_servers()

    async def set_hosts(self, names):
        """Show these servers, keeping state of ones already shown; check the new ones."""
        old = {h.name: h for h in self.hosts}
        self.hosts = [old.get(name) or Host(name) for name in names]
        self.cards = {h.name: Card(h) for h in self.hosts}
        await self.grid.remove_children()
        await self.grid.mount_all(self.cards.values())
        for card in self.cards.values():
            card.show()
        self.fit(self.size.width)
        self.update_all.disabled = not self.hosts
        if self.hosts:
            if self.selected not in self.hosts:
                self.selected = self.hosts[0]
            self.cards[self.selected.name].focus()
        self.start([h for h in self.hosts if h.name not in old], 'check')

    def fit(self, width):
        self.grid.styles.grid_size_columns = max(1, min(len(self.hosts), (width - 4) // 44))

    def on_resize(self, event):
        self.fit(event.size.width)

    def check_action(self, action, parameters):
        return bool(self.hosts) or action not in ('open', 'refresh', 'update', 'update_all', 'logs', 'ssh', 'move')

    def tick(self):
        for h in self.hosts:
            if h.status == 'running':
                self.cards[h.name].show()
        counts = Counter(h.status for h in self.hosts)
        left = Text.assemble((' t3up ', f'bold {BG} on {ACCENT}'), ('   On ', DIM), (LOCAL, TEXT),
                             ('   Desktop ', DIM), (short(self.desktop) or 'not detected', TEXT),
                             *((('   Installs ', DIM), (self.target, AMBER)) if self.target else ()))  # pinned only
        right = Text()
        for key, style, label in (('running', AMBER, 'busy'), ('ok', GREEN, 'ok'), ('failed', RED, 'failed')):
            if counts[key]:
                right.append(f'  ● {counts[key]} {label}', style=style)
        top = Table.grid(expand=True)
        top.add_column(ratio=1, no_wrap=True, overflow='ellipsis')
        top.add_column(justify='right', no_wrap=True)
        top.add_row(left, right)
        self.top.update(top)

    def select(self, host):
        self.selected = host
        log = self.output
        log.border_title = f' {host.name} output · {host.log.name if host.log else "no runs yet"} '
        log.clear()
        for line in host.lines:
            log.write(line)

    def emit(self, h, kind, text):
        if h.name in self.cards:  # a server removed mid-run finishes off-screen
            self.cards[h.name].show()
        if h is self.selected:
            if kind == 'start':
                self.select(h)
            elif kind in ('line', 'step'):
                self.output.write(text)
        if kind == 'done':
            logins = [name for name in h.auth if h.mode == 'update' and h.only in ('all', name.lower())]
            if logins:
                self.run_worker(self.sign_in(h, logins))
            if h.status == 'failed':
                self.notify(f'{h.name}: {h.error}', title='Failed', severity='error', timeout=8)
            elif h.mode == 'update':
                self.notify(f'{h.name} updated in {h.elapsed:.0f}s', title='Done')

    def start(self, hosts, mode, only='all'):
        if not hosts:
            return
        busy = [h.name for h in hosts if h.status == 'running']
        if busy:
            self.notify(f'Already running: {", ".join(busy)}', severity='warning')
        self.desktop = desktop_version()
        for h in hosts:
            if h.status != 'running':
                self.run_worker(run_job(h, mode, self.target, self.desktop, only, self.logs, self.emit))

    def update_menu(self, hosts, heading, extra=()):
        def chosen(choice):
            if choice == 'check':
                self.start(hosts, 'check')
            elif choice == 'ssh':
                self.action_ssh()
            elif choice == 'logs':
                self.action_logs()
            elif choice:
                self.start(hosts, 'update', choice)
        target = self.target or 'latest nightly'
        self.push_screen(Menu(heading, [
            'Update',
            ('all', '↑', 'Everything', ', '.join(COMPONENTS)),
            *((name.lower(), '↑', label, f'→ {target if name == "T3" else "latest"}')
              for name, label in COMPONENTS.items()),
            'Inspect',
            ('check', '↻', 'Check again', 'versions and health, changes nothing'),
            *extra,
        ]), chosen)

    def on_button_pressed(self, event):
        if event.button is self.update_all:
            self.action_update_all()

    def action_move(self, dx, dy):
        # Spatial grid movement: up/down jump a whole row, clamped to the first/last card.
        columns = self.grid.styles.grid_size_columns
        index = self.hosts.index(self.selected) + dx + dy * columns
        self.cards[self.hosts[max(0, min(len(self.hosts) - 1, index))].name].focus()

    def action_refresh(self):
        self.start(self.hosts, 'check')

    def action_open(self):
        h = self.selected
        icon, color, label = status(h, time.monotonic())
        self.update_menu([h], Text.assemble((h.name, 'bold'), '   ', (f'{icon} {label}', color)), [
            ('logs', '≡', 'Hide output' if self.output.has_class('shown') else 'Show output', 'live log below'),
            ('ssh', '›', 'Terminal', 'ssh in · type exit to return'),
        ])

    def action_update(self):
        self.update_menu([self.selected], Text(self.selected.name, style='bold'))

    def action_update_all(self):
        self.update_menu(self.hosts, Text.assemble(('All servers', 'bold'), (f'   {len(self.hosts)} in parallel', MUTED)))

    def action_version(self):
        def chosen(value):
            if value is not None:
                self.target = value
                self.notify(f'Updates will install T3 {value or "latest nightly"}')
        self.push_screen(VersionPrompt(self.target), chosen)

    def action_servers(self):
        async def saved(names):
            if names != [h.name for h in self.hosts]:
                await self.set_hosts(names)
        self.push_screen(ServersEditor(), saved)

    def action_logs(self):
        self.output.toggle_class('shown')

    def action_ssh(self, host=None):
        host = host or self.selected
        self.cards[host.name].focus()
        self.select(host)
        self.run_worker(self.ssh_session(host.name))

    async def ssh_session(self, name):
        await self.terminal('ssh', name)

    async def sign_in(self, h, names):
        for name in names:
            await self.terminal('ssh', '-t', h.name, login_command(name),
                                banner=f'Sign in to {name} on {h.name}. You come back here when it finishes.')
        self.start([h], 'check')  # show the new sign-in state

    async def terminal(self, *command, banner=''):
        """Hand the real terminal to command; one at a time, so logins on several servers queue up."""
        async with self.terminal_lock:
            # Jobs keep reading output meanwhile; batch_update stops redraws over the shell.
            with self.batch_update(), self.suspend():
                if banner:
                    print(f'\n  {banner}\n', flush=True)
                await (await asyncio.create_subprocess_exec(*command)).wait()

    def action_quit(self):
        busy = sum(h.status == 'running' for h in self.hosts)
        if busy and time.monotonic() - self.quit_armed > 3:
            self.quit_armed = time.monotonic()
            self.notify(f'{busy} server(s) still running. Press q again to stop them and quit.', severity='warning')
            return
        self.exit()

    def get_system_commands(self, screen):
        yield from super().get_system_commands(screen)
        yield SystemCommand('Refresh', 'Check every server', self.action_refresh)
        for key, label in (('all', 'everything'), *((name.lower(), name) for name in COMPONENTS)):
            yield SystemCommand(f'Update {label} on all servers', 'Runs in parallel',
                                lambda key=key: self.start(self.hosts, 'update', key))
        yield SystemCommand('Set T3 version', 'Pin the T3 version updates install', self.action_version)
        yield SystemCommand('Edit servers', 'Add, remove or rename SSH hosts', self.action_servers)
        for h in self.hosts:
            yield SystemCommand(f'SSH into {h.name}', 'Open a shell; exit to come back',
                                lambda h=h: self.action_ssh(h))


# ── Headless mode ───────────────────────────────────────────────────────────

async def headless(names, args, app, logs):
    width = max(map(len, names))

    def emit(h, kind, text):
        if kind == 'step' or (kind == 'line' and args.verbose):
            print(f'{h.name:<{width}}  {text}', flush=True)
        elif kind == 'done' and h.status == 'failed':
            print(f'{h.name:<{width}}  ✗ {h.error}\n{h.name:<{width}}  log: {h.log}', flush=True)
        if kind == 'done':
            for name in h.auth:
                print(f'{h.name:<{width}}  ! {name} not signed in; run: '
                      f'ssh -t {h.name} {shlex.quote(login_command(name))}', flush=True)

    hosts = [Host(name) for name in names]
    mode = 'check' if args.check else 'update'
    print(f'\nT3UP · {mode} · {len(hosts)} servers in parallel · from {LOCAL}\n')
    await asyncio.gather(*(run_job(h, mode, args.version, app, args.only or 'all', logs, emit) for h in hosts))
    print('\nRESULTS')
    for h in hosts:
        ok = h.status == 'ok'
        print(f'  {"✓" if ok else "✗"} {h.name:<16} {"OK" if ok else "FAILED":<7} {h.version:<35} {h.elapsed:.1f}s')
    failures = sum(h.status != 'ok' for h in hosts)
    print(f'\n{len(hosts) - failures}/{len(hosts)} passed · Logs: {logs}\n')
    return int(bool(failures))


def main():
    parser = argparse.ArgumentParser(description='Interactive dashboard for your T3 coding servers. '
        'Run without options to open it; use --check/--update for scripts.',
        epilog='Servers live in ~/.config/t3up/servers, one SSH alias or user@host per line. '
        'Press e in the dashboard to edit them.')
    parser.add_argument('version', nargs='?', default='', help='headless update to this exact T3 version')
    parser.add_argument('--check', action='store_true', help='headless: check versions and health')
    parser.add_argument('--update', action='store_true', help='headless: update servers')
    parser.add_argument('--only', choices=['all', *map(str.lower, COMPONENTS)],
                        help='headless update: only this component (default all)')
    parser.add_argument('--host', action='append', metavar='HOST', help='only this configured host (repeatable)')
    parser.add_argument('--list', action='store_true', help='list configured hosts and exit')
    parser.add_argument('--verbose', '-v', action='store_true', help='headless: show installer output')
    args = parser.parse_args()
    if args.version and not VERSION.fullmatch(args.version):
        parser.error('VERSION must be an exact version, for example 0.0.46-nightly.20261003.2623')
    if args.check and (args.version or args.update or args.only):
        parser.error('--check does not update')
    config = servers_file()
    try:
        hosts = parse_servers(config.read_text() if config.exists() else '')
    except (OSError, ValueError) as error:
        parser.error(f'{config}: {error}')
    headless_run = args.check or args.update or args.version or args.only
    if not hosts and (headless_run or args.host):
        parser.error(f'No servers in {config}; run t3up and press e to add some')
    if args.host:
        if set(args.host) - set(hosts):
            parser.error('Unknown host; add it to ' + str(config))
        hosts = [host for host in hosts if host in args.host]
    if args.list:
        print('\n'.join(hosts))
        return 0
    os.umask(0o077)
    logs = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 't3up' / datetime.now().strftime('%Y%m%d-%H%M%S-%f')
    if headless_run:
        return asyncio.run(headless(hosts, args, desktop_version(), logs))
    if not sys.stdout.isatty():
        parser.error('no terminal; use --check or --update')
    T3Up(hosts, logs).run()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print('\nInterrupted. An in-flight remote installer may still be running.', file=sys.stderr)
        sys.exit(130)
